{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "VPlant3D for OBS",
  "version": "0.0.0",
  "identifier": "com.togechiyo.vplant3d",
  "build": {
    "beforeDevCommand": "npm run tauri:relay",
    "devUrl": "http://127.0.0.1:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "VPlant3D for OBS",
        "url": "/?control=1",
        "width": 720,
        "height": 1100,
        "minWidth": 420,
        "minHeight": 720,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "GraphicsAndDesign",
    "resources": ["../dist"]
  }
}
