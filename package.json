{
  "name": "vplant3d",
  "version": "0.0.0",
  "description": "VPlant3D for OBS is a lightweight VRM / VRMA 3D avatar layer for OBS Browser Source.",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "node server/vplant-relay.mjs",
    "dev:vite": "vite --host 127.0.0.1",
    "tauri:relay": "node scripts/tauri-relay-dev.mjs",
    "tauri:dev": "tauri dev",
    "tauri:dev:attached": "tauri dev --config src-tauri/tauri.attached.conf.json --no-dev-server-wait",
    "tauri:build": "tauri build",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:watch": "vitest",
    "lint": "eslint ."
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/togechiyo/VPlant3D.git"
  },
  "keywords": [
    "vrm",
    "vrma",
    "obs",
    "threejs",
    "vtuber"
  ],
  "author": "togechiyo",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/togechiyo/VPlant3D/issues"
  },
  "homepage": "https://github.com/togechiyo/VPlant3D#readme",
  "dependencies": {
    "@mediapipe/tasks-vision": "^0.10.35",
    "@pixiv/three-vrm": "^3.5.3",
    "@pixiv/three-vrm-animation": "^3.5.3",
    "three": "^0.184.0",
    "zustand": "^5.0.13"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.60.0",
    "@tailwindcss/vite": "^4.3.0",
    "@tauri-apps/cli": "^2.11.2",
    "@types/node": "^25.9.1",
    "@types/three": "^0.184.1",
    "@types/ws": "^8.18.1",
    "eslint": "^10.4.0",
    "tailwindcss": "^4.3.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.4",
    "vite": "^8.0.13",
    "vitest": "^4.1.7",
    "ws": "^8.20.1"
  }
}
